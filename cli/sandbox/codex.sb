(version 1)
(deny default)
(import "bsd.sb")
(allow sysctl-read)
(allow process-exec (subpath (string-append (param "BREW") "/Caskroom/codex")))
(allow file-read*
  (subpath (string-append (param "BREW") "/Caskroom/codex"))
  (subpath (param "WORK"))
  (literal (param "PROJ"))
  (subpath "/private/etc/ssl")
  (literal "/private/etc/hosts")
  (literal "/private/etc/resolv.conf"))
(allow file-read* file-write* (subpath (param "CODEXHOME")))
(allow mach-lookup
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.SecurityServer")
  (global-name "com.apple.SystemConfiguration.configd"))
(allow system-socket)
(allow network-outbound
  (remote tcp "*:443")
  (literal "/private/var/run/mDNSResponder"))
(deny file-read* file-write*
  (literal (string-append (param "PROJ") "/secrets.enc.yaml"))
  (subpath (string-append (param "PROJ") "/.git"))
  (literal (string-append (param "PROJ") "/.debug/poly-resolve.db"))
  (subpath (string-append (param "HOME") "/.codex"))
  (subpath (string-append (param "HOME") "/.ssh")))
