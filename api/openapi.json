{
  "components": {
    "schemas": {
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "type": "object"
      },
      "HealthCheckResponse": {
        "properties": {
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "MessagesListItem": {
        "properties": {
          "account": {
            "type": "string"
          },
          "analysis": {
            "type": [
              "string",
              "null"
            ]
          },
          "conversation_id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "occurred_at_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "priority": {
            "format": "double",
            "type": [
              "number",
              "null"
            ]
          },
          "received_at_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "sender_id": {
            "type": "string"
          },
          "sender_name": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "topic": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "account",
          "conversation_id",
          "key",
          "occurred_at_ms",
          "received_at_ms",
          "sender_id",
          "sender_name",
          "source",
          "text"
        ],
        "type": "object"
      },
      "MessagesListRequest": {
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "from_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "limit": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "to_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "MessagesListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MessagesListItem"
            },
            "type": "array"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "items"
        ],
        "type": "object"
      },
      "ReviewItem": {
        "properties": {
          "batch_id": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "conversation_id": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "occurred_at_ms": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "reason": {
            "type": "string"
          },
          "sender": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "batch_id",
          "conversation_id",
          "flag",
          "key",
          "occurred_at_ms",
          "reason",
          "sender",
          "state",
          "text"
        ],
        "type": "object"
      },
      "ReviewKey": {
        "properties": {
          "key": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "type": "object"
      },
      "ReviewListRequest": {
        "properties": {
          "limit": {
            "format": "uint32",
            "minimum": 0,
            "type": [
              "integer",
              "null"
            ]
          },
          "state": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "type": "object"
      },
      "ReviewListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ReviewItem"
            },
            "type": "array"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReviewReason"
            },
            "type": "array"
          }
        },
        "required": [
          "items",
          "reasons"
        ],
        "type": "object"
      },
      "ReviewReason": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "placeholder": {
            "default": null,
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "code",
          "label"
        ],
        "type": "object"
      },
      "ReviewRulingResponse": {
        "properties": {
          "state": {
            "type": "string"
          }
        },
        "required": [
          "state"
        ],
        "type": "object"
      },
      "ReviewUpdateRequest": {
        "oneOf": [
          {
            "properties": {
              "state": {
                "const": "approved",
                "type": "string"
              }
            },
            "required": [
              "state"
            ],
            "type": "object"
          },
          {
            "properties": {
              "leak": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reason": {
                "type": "string"
              },
              "state": {
                "const": "rejected",
                "type": "string"
              }
            },
            "required": [
              "state",
              "reason"
            ],
            "type": "object"
          }
        ]
      }
    }
  },
  "info": {
    "title": "cli",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "parameters": [
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-session-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-user",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthCheckResponse"
                }
              }
            },
            "description": "success"
          },
          "403": {
            "description": "host not allowed"
          }
        }
      }
    },
    "/api/messages": {
      "get": {
        "parameters": [
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-session-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-user",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "from_ms",
            "required": false,
            "schema": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "to_ms",
            "required": false,
            "schema": {
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessagesListResponse"
                }
              }
            },
            "description": "success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "bad request"
          },
          "403": {
            "description": "host not allowed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "storage unavailable"
          }
        }
      }
    },
    "/api/reviews": {
      "get": {
        "parameters": [
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-session-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-user",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            }
          },
          {
            "in": "query",
            "name": "state",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewListResponse"
                }
              }
            },
            "description": "success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "bad request"
          },
          "403": {
            "description": "host not allowed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "storage unavailable"
          }
        }
      }
    },
    "/api/reviews/{key}": {
      "patch": {
        "parameters": [
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-session-id",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "set by the gateway",
            "in": "header",
            "name": "x-user",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpdateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewRulingResponse"
                }
              }
            },
            "description": "success"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "bad request"
          },
          "403": {
            "description": "host not allowed"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "already settled differently"
          },
          "415": {
            "description": "content-type is not application/json"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "violates review rules"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "storage unavailable"
          }
        }
      }
    }
  }
}
